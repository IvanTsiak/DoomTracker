@model IEnumerable<DoomTracker.Models.Debt>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>
<div class="row mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0"><i class="bi bi-pie-chart-fill"></i>Procrastination analytics</h5>
            </div>
            <div class="card-body d-flex justify-content-center">
                <canvas id="statusChart" style="max-height: 250px;"></canvas>
            </div>
        </div>
    </div>
</div>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.User)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Category)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Title)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Description)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Deadline)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Status)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ProofFilePath)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CreatedAt)
        </th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.User.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Deadline)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProofFilePath)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        $(document).ready(function () {
            $.get('/api/stats/status-chart', function (data) {
                
                const statusMap = {
                    'Pending': 'Pending',
                    'InProgress': 'In progress',
                    'Completed': 'Completed',
                    'Failed': 'Failed'
                };
                
                const colorMap = {
                    'Pending': '#6c757d',
                    'InProgress': '#ffc107',
                    'Completed': '#198754', 
                    'Failed': '#dc3545' 
                };
                
                let labels = data.map(item => {
                    let s = item.status || item.Status;
                    return statusMap[s] || s;
                });
                
                let counts = data.map(item => item.count || item.Count);
                
                let bgColors = data.map(item => {
                    let s = item.status || item.Status;
                    return colorMap[s] || '#0d6efd';
                });
                
                if (counts.length === 0) {
                    labels = ['No debts'];
                    counts = [1];
                    bgColors = ['#e9ecef'];
                }
                
                var ctx = document.getElementById('statusChart').getContext('2d');
                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Number of debts',
                            data: counts,
                            backgroundColor: bgColors,
                            borderWidth: 2,
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: {
                                position: 'right',
                            }
                        }
                    }
                });
            });
        });
    </script>
}
